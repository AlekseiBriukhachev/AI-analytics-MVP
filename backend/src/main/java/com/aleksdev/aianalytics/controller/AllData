package com.aianalytics.controller

import com.aianalytics.dto.*
import com.aianalytics.entity.MLModel
import com.aianalytics.service.MLModelService
import io.swagger.v3.oas.annotations.Operation
import io.swagger.v3.oas.annotations.tags.Tag
import jakarta.validation.Valid
import org.springframework.http.HttpStatus
import org.springframework.http.ResponseEntity
import org.springframework.web.bind.annotation.*
import java.util.concurrent.CompletableFuture

@RestController
@RequestMapping("/api/models")
@Tag(name = "ML Models", description = "API для управления моделями машинного обучения")
class MLModelController(private val modelService: MLModelService) {

    @PostMapping("/train")
    @Operation(summary = "Обучить новую модель", description = "Запускает процесс обучения нейронной сети")
    fun trainModel(@Valid @RequestBody request: TrainingRequest): ResponseEntity<ApiResponse<TrainingResponse>> {
        val result = modelService.trainModel(request)
        return ResponseEntity.status(HttpStatus.CREATED)
            .body(ApiResponse(success = true, data = result))
    }

    @PostMapping("/train-async")
    @Operation(summary = "Обучить модель асинхронно", description = "Запускает асинхронное обучение модели")
    fun trainModelAsync(@Valid @RequestBody request: TrainingRequest): ResponseEntity<ApiResponse<String>> {
        modelService.trainModelAsync(request)
        return ResponseEntity.accepted()
            .body(ApiResponse(success = true, data = "Training started asynchronously"))
    }

    @PostMapping("/predict")
    @Operation(summary = "Сделать предсказание", description = "Использует обученную модель для предсказания")
    fun predict(@Valid @RequestBody request: PredictionRequest): ResponseEntity<ApiResponse<PredictionResponse>> {
        val result = modelService.predict(request)
        return ResponseEntity.ok(ApiResponse(success = true, data = result))
    }

    @GetMapping
    @Operation(summary = "Получить все модели")
    fun getAllModels(): ResponseEntity<ApiResponse<List<MLModel>>> {
        val models = modelService.getAllModels()
        return ResponseEntity.ok(ApiResponse(success = true, data = models))
    }

    @GetMapping("/{id}")
    @Operation(summary = "Получить модель по ID")
    fun getModel(@PathVariable id: String): ResponseEntity<ApiResponse<MLModel>> {
        val model = modelService.getModel(id)
        return ResponseEntity.ok(ApiResponse(success = true, data = model))
    }

    @GetMapping("/by-dataset/{datasetId}")
    @Operation(summary = "Получить модели по датасету")
    fun getModelsByDataset(@PathVariable datasetId: String): ResponseEntity<ApiResponse<List<MLModel>>> {
        val models = modelService.getModelsByDataset(datasetId)
        return ResponseEntity.ok(ApiResponse(success = true, data = models))
    }

    @DeleteMapping("/{id}")
    @Operation(summary = "Удалить модель")
    fun deleteModel(@PathVariable id: String): ResponseEntity<ApiResponse<String>> {
        modelService.deleteModel(id)
        return ResponseEntity.ok(ApiResponse(success = true, data = "Model deleted successfully"))
    }
}

// src/main/kotlin/com/aianalytics/controller/AnalyticsController.kt
package com.aianalytics.controller

import com.aianalytics.repository.DatasetRepository
import com.aianalytics.repository.MLModelRepository
import io.swagger.v3.oas.annotations.Operation
import io.swagger.v3.oas.annotations.tags.Tag
import org.springframework.http.ResponseEntity
import org.springframework.web.bind.annotation.GetMapping
import org.springframework.web.bind.annotation.RequestMapping
import org.springframework.web.bind.annotation.RestController
import java.time.LocalDateTime

@RestController
@RequestMapping("/api/analytics")
@Tag(name = "Analytics", description = "API для получения аналитики и статистики")
class AnalyticsController(
    private val datasetRepository: DatasetRepository,
    private val modelRepository: MLModelRepository
) {

    @GetMapping("/dashboard")
    @Operation(summary = "Получить данные для дашборда")
    fun getDashboard(): ResponseEntity<Map<String, Any>> {
        val since24h = LocalDateTime.now().minusDays(1)
        val since7d = LocalDateTime.now().minusDays(7)

        val dashboardData = mapOf(
            "totalDatasets" to datasetRepository.count(),
            "totalModels" to modelRepository.count(),
            "datasetsLast24h" to datasetRepository.countCreatedSince(since24h),
            "modelsLast24h" to modelRepository.countCreatedSince(since24h),
            "datasetsLast7d" to datasetRepository.countCreatedSince(since7d),
            "modelsLast7d" to modelRepository.countCreatedSince(since7d),
            "recentDatasets" to datasetRepository.findTop10ByOrderByCreatedAtDesc(),
            "topModels" to modelRepository.findTop10ByOrderByAccuracyDesc()
        )

        return ResponseEntity.ok(dashboardData)
    }
}

