    echo "❌ Docker не установлен!"
    exit 1
fi

if ! command -v java &> /dev/null; then
    echo "❌ Java не установлен!"
    exit 1
fi

# Создание необходимых директорий
mkdir -p logs
mkdir -p ssl

# Генерация самоподписанного сертификата для тестирования
